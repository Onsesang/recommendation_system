# Copy this file to shopping_agent/.env, then fill secrets locally.
# Never paste real keys into Markdown, shell history, Git, or chat.
# LLM: OpenAI only (tool-loop agent). Gemini is not used.
SHOPPING_AGENT_LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

SHOPPING_AGENT_HOST=127.0.0.1
SHOPPING_AGENT_PORT=8878
# Comma-separated browser origins allowed to call the API.
SHOPPING_AGENT_CORS_ORIGINS=https://onsesang-front.vercel.app,http://localhost:3000
# true only behind HTTPS (tunnel/proxy); keep false for local http testing.
SHOPPING_AGENT_COOKIE_SECURE=false
# full = 825,840 products with image-predicted tactile, curated = 465 review-grounded products
SHOPPING_AGENT_CATALOG=full
SHOPPING_AGENT_DB=shopping_agent/data/agent_v1.sqlite3
SHOPPING_AGENT_SESSION_DAYS=30

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=material-shopping-agent-v1
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
