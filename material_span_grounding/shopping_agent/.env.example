# Copy this file to shopping_agent/.env on the A100 server, then fill secrets locally.
# Never paste real keys into Markdown, shell history, Git, or Codex chat.
SHOPPING_AGENT_LLM_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

SHOPPING_AGENT_HOST=127.0.0.1
SHOPPING_AGENT_PORT=8878
SHOPPING_AGENT_CORS_ORIGIN=http://127.0.0.1:8878
SHOPPING_AGENT_DB=shopping_agent/data/agent_v1.sqlite3
SHOPPING_AGENT_SESSION_DAYS=30

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=material-shopping-agent-v1
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
